{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Workspace Launcher",
  "version": "0.1.0",
  "identifier": "com.smartworkspace.launcher",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Smart Workspace Launcher",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      },
      {
        "label": "quick-launch",
        "title": "Quick Launch",
        "width": 620,
        "height": 420,
        "minWidth": 460,
        "minHeight": 220,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "center": true
      },
      {
        "label": "dock",
        "title": "Workspace Dock",
        "width": 96,
        "height": 540,
        "minWidth": 64,
        "minHeight": 64,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A local-first launcher for work resources",
    "longDescription": "Smart Workspace Launcher organizes and opens resources through Windows default applications."
  }
}
