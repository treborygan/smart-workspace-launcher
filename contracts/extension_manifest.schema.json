{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Workspace Launcher extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "sdkVersion", "description", "requestedCapabilities"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 5,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+){2,}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "sdkVersion": { "const": "1.0.0" },
    "description": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
    "requestedCapabilities": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["resource_metadata.read", "workspace_summary.read"] }
    }
  }
}
