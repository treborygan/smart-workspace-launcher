{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "resource_id", "source", "status", "launched_at_utc"],
        "properties": {
          "request_id": { "type": "string", "format": "uuid" },
          "resource_id": { "type": "string", "format": "uuid" },
          "target_id": { "type": ["string", "null"], "format": "uuid" },
          "source": { "enum": ["dashboard", "quick_launch", "dock", "explorer", "other"] },
          "status": { "enum": ["requested", "handed_off", "failed"] },
          "launched_at_utc": { "type": "string", "format": "date-time" },
          "error_code": { "type": ["string", "null"], "maxLength": 128 },
          "message": { "type": ["string", "null"], "maxLength": 1024 },
          "duration_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 3600000 }
        }
      }
    }
  }
}
