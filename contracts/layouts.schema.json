{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layouts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "layouts": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "breakpoint",
          "cards"
        ],
        "properties": {
          "breakpoint": {
            "enum": [
              "desktop",
              "tablet",
              "compact"
            ]
          },
          "cards": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource_id",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "resource_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                },
                "w": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "h": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "type": {
                  "enum": [
                    "icon",
                    "compact",
                    "info",
                    "group"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
