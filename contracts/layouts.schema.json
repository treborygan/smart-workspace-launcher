{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layouts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "layouts": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "breakpoint",
          "cards"
        ],
        "properties": {
          "surface": {
            "enum": ["dashboard", "dock"]
          },
          "breakpoint": {
            "enum": [
              "desktop",
              "tablet",
              "compact"
            ]
          },
          "cards": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource_id",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "resource_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 11
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                },
                "w": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "h": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "type": {
                  "enum": [
                    "icon",
                    "compact",
                    "info",
                    "group"
                  ]
                }
              }
            }
          },
          "widget_templates": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "name", "kind", "config"],
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                    "kind": { "const": "resource_shortcuts" },
                    "config": {
                      "type": "object", "additionalProperties": false,
                      "required": ["resource_ids"],
                      "properties": { "resource_ids": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } } }
                    }
                  }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "name", "kind", "config"],
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                    "kind": { "const": "recent_launches" },
                    "config": { "type": "object", "additionalProperties": false, "required": ["limit"], "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 20 } } }
                  }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "name", "kind", "config"],
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                    "kind": { "const": "launch_summary" },
                    "config": { "type": "object", "additionalProperties": false, "required": ["period"], "properties": { "period": { "enum": ["7d", "30d", "all"] } } }
                  }
                },
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["id", "name", "kind", "config"],
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                    "kind": { "const": "related_resources" },
                    "config": { "type": "object", "additionalProperties": false, "required": ["resource_id", "limit"], "properties": { "resource_id": { "type": "string", "format": "uuid" }, "limit": { "type": "integer", "minimum": 1, "maximum": 12 } } }
                  }
                }
              ]
            }
          },
          "widgets": {
            "type": "array", "maxItems": 50,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "template_id", "x", "y", "w", "h"],
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "template_id": { "type": "string", "format": "uuid" },
                "x": { "type": "integer", "minimum": 0, "maximum": 11 },
                "y": { "type": "integer", "minimum": 0, "maximum": 9999 },
                "w": { "type": "integer", "minimum": 1, "maximum": 12 },
                "h": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            }
          }
        }
      }
    }
  }
}
