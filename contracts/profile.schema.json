{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "theme",
    "settings",
    "memberships"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "theme": {
      "type": "object",
      "required": [
        "mode",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "density": {
          "enum": [
            "compact",
            "balanced",
            "comfortable"
          ]
        }
      }
    },
    "settings": {
      "type": "object",
      "maxProperties": 50
    },
    "memberships": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  }
}
