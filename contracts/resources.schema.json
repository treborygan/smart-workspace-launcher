{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "resources": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "id",
          "name",
          "type",
          "targets"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "type": {
            "enum": [
              "file",
              "folder",
              "app",
              "shortcut",
              "url"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "tags": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "aliases": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "icon": {
            "type": "string",
            "maxLength": 128
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "value",
                "priority"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "kind": {
                  "enum": [
                    "file",
                    "folder",
                    "app",
                    "shortcut",
                    "url"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "device_label": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "argv": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "working_directory": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            }
          }
        }
      }
    }
  }
}
