{
  "name": "smart-workspace-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "frontend:dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json -- --locked",
    "frontend:build": "vite build --config apps/desktop/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "lint": "npm run typecheck",
    "test": "vitest run --config apps/desktop/vite.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
